{
  "strataApi": "^1.0",
  "id": "starter.topic",
  "name": "Pub/sub topic",
  "version": "1.0.0",
  "category": "Messaging",
  "description": "A partitioned stream that every consumer group reads (Kafka, Kinesis, Pub/Sub, SNS).",
  "icon": "icon.svg",
  "entry": "index.js",
  "extends": "base:topic",
  "shape": "queue",
  "ports": [
    {
      "name": "in",
      "direction": "in",
      "accepts": ["async-message"],
      "exposes": ["publish", "subscribe", "poll", "commit"]
    }
  ],
  "state": {
    "logs": {
      "type": "map",
      "initial": {},
      "description": "Each partition’s retained messages and its next offset"
    },
    "offsets": {
      "type": "map",
      "initial": {},
      "description": "Each consumer group’s partitions, positions and committed offsets"
    },
    "published": {
      "type": "integer",
      "initial": 0,
      "description": "Messages published, which spreads keyless ones over the partitions"
    },
    "bytes": {
      "type": "integer",
      "initial": 0,
      "unit": "bytes",
      "description": "Size of the retained messages, before replication"
    },
    "buckets": {
      "type": "map",
      "initial": {},
      "description": "Each partition’s throughput allowance in bytes"
    },
    "dedup": {
      "type": "map",
      "initial": {},
      "description": "Partition and offset by dedupId, for exactly-once delivery"
    }
  },
  "methods": {
    "public": {
      "publish": {
        "input": "message",
        "output": "{ partition, offset, duplicate? }",
        "errors": ["PARTITION_THROTTLED"]
      },
      "subscribe": {
        "input": {
          "group": "string"
        },
        "output": "{ group, partitions }"
      },
      "poll": {
        "input": {
          "group": "string",
          "max": "integer"
        },
        "output": "{ partition, offset, body }[]",
        "errors": ["UNKNOWN_GROUP"]
      },
      "commit": {
        "input": {
          "group": "string",
          "partition": "integer",
          "offset": "integer"
        },
        "output": "{ ok }",
        "errors": ["UNKNOWN_GROUP", "OFFSET_OUT_OF_RANGE"]
      }
    },
    "private": {
      "assignPartitions": {},
      "compact": {},
      "trimRetention": {}
    }
  },
  "properties": {
    "partitions": {
      "type": "integer",
      "unit": "partitions",
      "default": 6,
      "min": 1,
      "group": "Capacity",
      "rollup": "sum"
    },
    "throughputPerPartition": {
      "type": "number",
      "unit": "MB/s",
      "default": 10,
      "min": 0,
      "group": "Capacity"
    },
    "replicationFactor": {
      "type": "integer",
      "unit": "replicas",
      "default": 3,
      "min": 1,
      "group": "Durability"
    },
    "retentionTime": {
      "type": "duration",
      "default": "7d",
      "group": "Durability"
    },
    "retentionSize": {
      "type": "bytes",
      "default": "100GB",
      "group": "Durability",
      "rollup": "sum"
    },
    "compaction": {
      "type": "boolean",
      "default": false,
      "group": "Durability",
      "description": "Keep only the latest message per key"
    },
    "consumerGroups": {
      "type": "list",
      "items": {
        "type": "string"
      },
      "default": [],
      "group": "Consumers"
    },
    "orderingKey": {
      "type": "string",
      "default": "",
      "group": "Delivery",
      "description": "Message field that picks the partition"
    },
    "deliverySemantics": {
      "type": "enum",
      "values": ["at-most-once", "at-least-once", "exactly-once"],
      "default": "at-least-once",
      "group": "Delivery"
    }
  },
  "metrics": {
    "publishRate": {
      "unit": "msg/s",
      "rollup": "sum"
    },
    "consumerLag": {
      "unit": "messages",
      "rollup": "sum",
      "description": "Per consumer group"
    },
    "consumerLagTime": {
      "unit": "s",
      "rollup": "max"
    },
    "partitionSkew": {
      "unit": "%",
      "rollup": "max"
    },
    "retainedBytes": {
      "unit": "bytes",
      "rollup": "sum"
    }
  }
}
