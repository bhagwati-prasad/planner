{
  "strataApi": "^1.0",
  "id": "starter.relational-db",
  "name": "Relational DB",
  "version": "1.0.0",
  "category": "Data",
  "description": "A SQL database with connections, replicas and locks (PostgreSQL, MySQL, SQL Server).",
  "icon": "icon.svg",
  "extends": "base:store",
  "entry": "index.js",
  "shape": "cylinder",
  "ports": [
    {
      "name": "in",
      "direction": "in",
      "accepts": ["db-protocol"],
      "exposes": ["query", "insert", "update", "delete", "begin", "commit", "rollback"]
    }
  ],
  "servers": {
    "count": ["maxConnections"],
    "metrics": { "busy": "activeConnections", "waiting": "waitingConnections" }
  },
  "state": {
    "tables": {
      "type": "map",
      "initial": {},
      "description": "By table, by id: each committed row, when it was committed in ms, and its size in bytes"
    },
    "replica": {
      "type": "map",
      "initial": {},
      "description": "By table, by id: the rows the read replicas have applied"
    },
    "nextId": {
      "type": "map",
      "values": { "type": "integer" },
      "initial": {},
      "description": "By table: the last id it gave"
    },
    "transactions": {
      "type": "map",
      "initial": {},
      "description": "By id: each open transaction, when it began in ms, and its writes"
    },
    "nextTx": { "type": "integer", "initial": 0 },
    "locks": {
      "type": "map",
      "initial": {},
      "description": "By table and row id: the transaction holding the row"
    },
    "waitsFor": {
      "type": "map",
      "initial": {},
      "description": "By transaction: the transaction whose lock it waits for"
    },
    "replicatedUntil": {
      "type": "number",
      "initial": 0,
      "description": "When the replicas apply the last write committed, in ms"
    },
    "storage": { "type": "number", "initial": 0, "description": "Bytes stored" },
    "ioWindow": {
      "type": "integer",
      "initial": -1,
      "description": "The second IOPS are counted in"
    },
    "ioUsed": { "type": "integer", "initial": 0, "description": "IOs used in that second" },
    "availableAt": {
      "type": "number",
      "initial": 0,
      "description": "When a failover in progress ends, in ms"
    }
  },
  "methods": {
    "public": {
      "query": {
        "errors": ["NO_TRANSACTION", "UNAVAILABLE"],
        "description": "{ table, where?, limit?, tx?, primary? } → the rows whose columns equal where's"
      },
      "insert": {
        "errors": [
          "DUPLICATE_KEY",
          "STORAGE_FULL",
          "DEADLOCK",
          "SERIALIZATION_FAILURE",
          "LOCK_TIMEOUT",
          "NO_TRANSACTION",
          "UNAVAILABLE"
        ],
        "description": "{ table, row, tx? } → { id }"
      },
      "update": {
        "errors": [
          "DEADLOCK",
          "SERIALIZATION_FAILURE",
          "LOCK_TIMEOUT",
          "NO_TRANSACTION",
          "UNAVAILABLE"
        ],
        "description": "{ table, where, set, tx? } → { updated }"
      },
      "delete": {
        "errors": [
          "DEADLOCK",
          "SERIALIZATION_FAILURE",
          "LOCK_TIMEOUT",
          "NO_TRANSACTION",
          "UNAVAILABLE"
        ],
        "description": "{ table, where, tx? } → { deleted }"
      },
      "begin": {
        "latency": 0,
        "errors": ["UNAVAILABLE"],
        "description": "{} → { tx }"
      },
      "commit": {
        "errors": ["NO_TRANSACTION", "UNAVAILABLE"],
        "description": "{ tx } → { committed }"
      },
      "rollback": {
        "latency": 0,
        "errors": ["NO_TRANSACTION", "UNAVAILABLE"],
        "description": "{ tx } → { rolledBack }"
      }
    },
    "private": {
      "acquireConnection": {},
      "lock": {},
      "replicate": {},
      "failover": {}
    }
  },
  "properties": {
    "vcpu": {
      "type": "integer",
      "unit": "vCPU",
      "default": 4,
      "min": 1,
      "group": "Instance"
    },
    "ram": {
      "type": "bytes",
      "default": "16GB",
      "group": "Instance"
    },
    "maxConnections": {
      "type": "integer",
      "unit": "connections",
      "default": 200,
      "min": 1,
      "group": "Instance"
    },
    "readLatency": {
      "type": "distribution",
      "unit": "ms",
      "default": {
        "kind": "lognormal",
        "median": 2,
        "p99": 15
      },
      "group": "Performance"
    },
    "writeLatency": {
      "type": "distribution",
      "unit": "ms",
      "default": {
        "kind": "lognormal",
        "median": 5,
        "p99": 40
      },
      "group": "Performance"
    },
    "iopsLimit": {
      "type": "integer",
      "unit": "IOPS",
      "default": 3000,
      "min": 1,
      "group": "Performance"
    },
    "lockContention": {
      "type": "number",
      "unit": "factor",
      "default": 0.05,
      "min": 0,
      "max": 1,
      "group": "Performance",
      "description": "Share of writes that wait on a lock"
    },
    "isolationLevel": {
      "type": "enum",
      "values": ["read-uncommitted", "read-committed", "repeatable-read", "serializable"],
      "default": "read-committed",
      "group": "Performance"
    },
    "readReplicas": {
      "type": "integer",
      "unit": "replicas",
      "default": 0,
      "min": 0,
      "group": "Replication",
      "rollup": "sum"
    },
    "replicationLag": {
      "type": "distribution",
      "unit": "ms",
      "default": {
        "kind": "lognormal",
        "median": 20,
        "p99": 200
      },
      "group": "Replication"
    },
    "failoverTime": {
      "type": "duration",
      "default": "30s",
      "group": "Replication"
    },
    "storageUsed": {
      "type": "bytes",
      "default": "50GB",
      "group": "Storage",
      "rollup": "sum"
    },
    "storageCapacity": {
      "type": "bytes",
      "default": "500GB",
      "group": "Storage",
      "rollup": "sum"
    }
  },
  "metrics": {
    "latency.p50": {
      "estimate": "readLatency.p50"
    },
    "latency.p95": {
      "estimate": "readLatency.p95"
    },
    "latency.p99": {
      "estimate": "readLatency.p99"
    },
    "activeConnections": {
      "unit": "connections",
      "rollup": "sum"
    },
    "waitingConnections": {
      "unit": "connections",
      "rollup": "sum"
    },
    "readQps": {
      "unit": "queries/s",
      "rollup": "sum"
    },
    "writeQps": {
      "unit": "queries/s",
      "rollup": "sum"
    },
    "iopsUsed": {
      "unit": "IOPS",
      "rollup": "sum"
    },
    "storageUse": {
      "unit": "%",
      "rollup": "max"
    },
    "replicaLag": {
      "unit": "ms",
      "rollup": "max"
    },
    "deadlocks": {
      "unit": "deadlocks",
      "rollup": "sum"
    }
  }
}
