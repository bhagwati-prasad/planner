{
  "strataApi": "^1.0",
  "id": "starter.service",
  "name": "Service",
  "version": "1.0.0",
  "category": "Compute",
  "description": "An API or backend service: instances with limited concurrency that call downstream dependencies.",
  "icon": "icon.svg",
  "extends": "base:service",
  "entry": "index.js",
  "shape": "box",
  "ports": [
    {
      "name": "in",
      "direction": "in",
      "accepts": ["http", "grpc", "websocket"],
      "exposes": ["request", "health"],
      "default": "request"
    },
    {
      "name": "out",
      "direction": "out"
    }
  ],
  "servers": {
    "count": ["state.liveInstances", "concurrency"],
    "backlog": "maxBacklog",
    "timeout": "timeout"
  },
  "state": {
    "liveInstances": {
      "type": "integer",
      "initial": 1,
      "description": "Instances running now; autoscaling changes it"
    },
    "inFlight": {
      "type": "integer",
      "initial": 0,
      "description": "Requests on a server now"
    },
    "health": {
      "type": "string",
      "initial": "up"
    },
    "circuits": {
      "type": "map",
      "initial": {},
      "description": "By downstream call: its breaker's state and its last outcomes"
    },
    "busySince": {
      "type": "number",
      "initial": -1,
      "description": "When utilisation last rose over the target, in ms; -1 when it is not over"
    },
    "lastScaledAt": {
      "type": "number",
      "initial": -1,
      "description": "When autoscaling last changed liveInstances, in ms; -1 before it has"
    }
  },
  "methods": {
    "public": {
      "request": {
        "latency": 0,
        "errors": ["NO_ENDPOINT", "CIRCUIT_OPEN", "DEPENDENCY_FAILED", "BACKLOG_FULL", "TIMEOUT"],
        "description": "Runs the endpoint the request's path and method header match"
      },
      "health": {
        "latency": 0
      }
    },
    "private": {
      "admit": {},
      "retry": {},
      "tripCircuit": {},
      "autoscale": {}
    }
  },
  "properties": {
    "concurrency": {
      "type": "integer",
      "unit": "requests",
      "default": 64,
      "min": 1,
      "group": "Capacity",
      "description": "Per instance"
    },
    "maxBacklog": {
      "type": "integer",
      "unit": "requests",
      "default": 1000,
      "min": 0,
      "group": "Capacity"
    },
    "serviceTime": {
      "type": "distribution",
      "unit": "ms",
      "default": {
        "kind": "lognormal",
        "median": 20,
        "p99": 150
      },
      "group": "Performance",
      "description": "Default for endpoints that do not set their own"
    },
    "endpoints": {
      "type": "list",
      "items": {
        "type": "map"
      },
      "default": [],
      "group": "Performance",
      "description": "Each: { \"name\": \"GET /orders\", \"serviceTime\": {...}, \"calls\": [\"out\", \"out.insert\"] }; service time in ms, calls as port or port.method"
    },
    "cpuPerRequest": {
      "type": "number",
      "unit": "ms",
      "default": 5,
      "min": 0,
      "group": "Resources"
    },
    "memoryPerRequest": {
      "type": "number",
      "unit": "MB",
      "default": 2,
      "min": 0,
      "group": "Resources"
    },
    "timeout": {
      "type": "duration",
      "default": "5s",
      "group": "Reliability"
    },
    "retries": {
      "type": "integer",
      "unit": "retries",
      "default": 2,
      "min": 0,
      "group": "Reliability"
    },
    "retryBackoff": {
      "type": "duration",
      "default": "100ms",
      "group": "Reliability"
    },
    "circuitBreaker": {
      "type": "boolean",
      "default": false,
      "group": "Circuit breaker"
    },
    "breakerErrorThreshold": {
      "type": "percent",
      "unit": "%",
      "default": 50,
      "group": "Circuit breaker"
    },
    "breakerOpenDuration": {
      "type": "duration",
      "default": "30s",
      "group": "Circuit breaker"
    },
    "autoscaling": {
      "type": "boolean",
      "default": false,
      "group": "Autoscaling"
    },
    "minInstances": {
      "type": "integer",
      "unit": "instances",
      "default": 1,
      "min": 0,
      "group": "Autoscaling"
    },
    "maxInstances": {
      "type": "integer",
      "unit": "instances",
      "default": 10,
      "min": 1,
      "group": "Autoscaling"
    },
    "targetUtilisation": {
      "type": "percent",
      "unit": "%",
      "default": 70,
      "group": "Autoscaling"
    },
    "scaleUpDelay": {
      "type": "duration",
      "default": "60s",
      "group": "Autoscaling"
    },
    "cooldown": {
      "type": "duration",
      "default": "5m",
      "group": "Autoscaling"
    }
  },
  "metrics": {
    "latency.p50": {
      "estimate": "serviceTime.p50"
    },
    "latency.p95": {
      "estimate": "serviceTime.p95"
    },
    "latency.p99": {
      "estimate": "serviceTime.p99"
    },
    "backlog": {
      "unit": "requests",
      "rollup": "sum"
    },
    "liveInstances": {
      "unit": "instances",
      "rollup": "sum"
    },
    "circuitState": {
      "unit": "state",
      "description": "Per downstream call, as circuitState.<call>",
      "rollup": {
        "rule": "worst",
        "order": ["closed", "half-open", "open"]
      }
    },
    "errors": {
      "unit": "errors/s",
      "rollup": "sum"
    }
  }
}
