{
  "strataApi": "^1.0",
  "id": "starter.api-gateway",
  "name": "API gateway",
  "version": "1.0.0",
  "category": "Edge",
  "description": "The front door for APIs: routing, authentication, rate limits and caching.",
  "icon": "icon.svg",
  "extends": "base:proxy",
  "entry": "index.js",
  "shape": "hexagon",
  "ports": [
    {
      "name": "in",
      "direction": "in",
      "accepts": ["http", "grpc", "websocket"],
      "exposes": ["forward"],
      "default": "forward"
    },
    {
      "name": "out",
      "direction": "out"
    }
  ],
  "state": {
    "buckets": {
      "type": "map",
      "initial": {},
      "description": "By key: the tokens its rate-limit bucket holds, and when they were counted, in ms"
    },
    "cache": {
      "type": "map",
      "initial": {},
      "description": "By path: a cached response body, and when it was cached, in ms"
    },
    "cacheLookups": {
      "type": "integer",
      "initial": 0
    },
    "cacheHits": {
      "type": "integer",
      "initial": 0
    }
  },
  "methods": {
    "public": {
      "forward": {
        "latency": 0,
        "errors": [
          "NO_ROUTE",
          "PAYLOAD_TOO_LARGE",
          "AUTH_FAILED",
          "THROTTLED",
          "GATEWAY_TIMEOUT",
          "BAD_GATEWAY"
        ],
        "description": "Checks a request, then answers it from the cache or forwards it on out with its path and headers"
      }
    },
    "private": {
      "authenticate": {},
      "rateLimit": {},
      "transform": {},
      "cacheLookup": {}
    }
  },
  "properties": {
    "routes": {
      "type": "list",
      "items": {
        "type": "string"
      },
      "default": [],
      "group": "Routing",
      "description": "e.g. \"GET /orders/*\""
    },
    "authMode": {
      "type": "enum",
      "values": ["none", "api-key", "jwt", "oauth2", "mtls"],
      "default": "jwt",
      "group": "Security"
    },
    "rateLimit": {
      "type": "rate",
      "default": "100/s",
      "group": "Limits",
      "description": "Per API key"
    },
    "burst": {
      "type": "integer",
      "unit": "requests",
      "default": 200,
      "min": 0,
      "group": "Limits"
    },
    "maxPayload": {
      "type": "bytes",
      "default": "10MB",
      "group": "Limits"
    },
    "requestTimeout": {
      "type": "duration",
      "default": "29s",
      "group": "Limits"
    },
    "transformLatency": {
      "type": "distribution",
      "unit": "ms",
      "default": {
        "kind": "lognormal",
        "median": 1,
        "p99": 5
      },
      "group": "Performance"
    },
    "responseCacheTtl": {
      "type": "duration",
      "default": "0s",
      "group": "Performance",
      "description": "0 turns the response cache off"
    }
  },
  "metrics": {
    "latency.p50": {
      "estimate": "transformLatency.p50"
    },
    "latency.p95": {
      "estimate": "transformLatency.p95"
    },
    "latency.p99": {
      "estimate": "transformLatency.p99"
    },
    "throttled": {
      "unit": "req/s",
      "rollup": "sum"
    },
    "authFailures": {
      "unit": "req/s",
      "rollup": "sum"
    },
    "cacheHitRatio": {
      "unit": "%",
      "rollup": "min"
    }
  }
}
