{
  "strataApi": "^1.0",
  "id": "starter.scheduler",
  "name": "Scheduler (cron)",
  "version": "1.0.0",
  "category": "Compute",
  "description": "Starts jobs on a cron schedule.",
  "icon": "icon.svg",
  "extends": "base:timer",
  "entry": "index.js",
  "ports": [
    {
      "name": "in",
      "direction": "in",
      "exposes": ["trigger", "pause", "resume"],
      "description": "For runs on demand, and to pause and resume the schedule"
    },
    {
      "name": "out",
      "direction": "out",
      "description": "Where each run sends its job"
    }
  ],
  "shape": "ellipse",
  "state": {
    "nextAt": {
      "type": "number",
      "initial": 0,
      "description": "The next time the cron expression matches, in ms, or -1 when it never does"
    },
    "active": {
      "type": "list",
      "items": { "type": "integer" },
      "initial": [],
      "description": "The runs still going"
    },
    "missed": {
      "type": "integer",
      "initial": 0,
      "description": "Schedules missed while paused, since it was last resumed"
    }
  },
  "methods": {
    "public": {
      "trigger": {
        "errors": ["PAUSED"],
        "description": "{} → { run }; a run now, by the concurrency policy"
      },
      "pause": { "description": "{} → null; schedules are missed until resume" },
      "resume": { "description": "{} → null; with catchUp, runs once if it missed any" }
    },
    "private": {
      "tick": {},
      "dispatch": {}
    }
  },
  "properties": {
    "cron": {
      "type": "string",
      "default": "*/5 * * * *",
      "group": "Schedule",
      "description": "Five-field cron expression"
    },
    "jitter": {
      "type": "duration",
      "default": "0s",
      "group": "Schedule"
    },
    "catchUp": {
      "type": "boolean",
      "default": false,
      "group": "Schedule",
      "description": "Run missed schedules after downtime"
    },
    "jobDuration": {
      "type": "distribution",
      "unit": "ms",
      "default": {
        "kind": "lognormal",
        "median": 2000,
        "p99": 20000
      },
      "group": "Jobs"
    },
    "concurrencyPolicy": {
      "type": "enum",
      "values": ["allow", "forbid", "replace"],
      "default": "forbid",
      "group": "Jobs"
    }
  },
  "metrics": {
    "runs": {
      "unit": "runs",
      "rollup": "sum"
    },
    "overlaps": {
      "unit": "runs",
      "rollup": "sum"
    },
    "missedRuns": {
      "unit": "runs",
      "rollup": "sum"
    },
    "duration": {
      "unit": "ms",
      "rollup": "max"
    }
  }
}
