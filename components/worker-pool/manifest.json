{
  "strataApi": "^1.0",
  "id": "starter.worker-pool",
  "name": "Worker pool",
  "version": "1.0.0",
  "category": "Compute",
  "description": "Consumers that pull messages from a queue or topic in batches.",
  "icon": "icon.svg",
  "entry": "index.js",
  "extends": "base:service",
  "shape": "component",
  "ports": [
    {
      "name": "in",
      "direction": "in",
      "accepts": ["async-message"],
      "exposes": ["status"]
    },
    {
      "name": "out",
      "direction": "out",
      "description": "The handler each message goes to; the edge names its method"
    },
    {
      "name": "source",
      "direction": "out",
      "accepts": ["async-message"],
      "description": "The queue it receives from and acknowledges to"
    }
  ],
  "state": {
    "busy": {
      "type": "integer",
      "initial": 0,
      "unit": "workers",
      "description": "Workers processing or waiting to retry a message"
    },
    "buffer": {
      "type": "queue",
      "initial": [],
      "description": "Received messages waiting for a free worker"
    },
    "batches": {
      "type": "map",
      "initial": {},
      "description": "Each open batch: when it arrived and how many of its messages are left"
    },
    "received": {
      "type": "integer",
      "initial": 0,
      "description": "Batches received, which numbers them"
    }
  },
  "methods": {
    "public": {
      "status": {
        "output": "{ consumers, busy, buffered, idle }"
      }
    },
    "private": {
      "poll": {},
      "process": {},
      "retry": {}
    }
  },
  "properties": {
    "consumers": {
      "type": "integer",
      "unit": "workers",
      "default": 8,
      "min": 0,
      "group": "Capacity",
      "rollup": "sum"
    },
    "batchSize": {
      "type": "integer",
      "unit": "messages",
      "default": 10,
      "min": 1,
      "group": "Processing"
    },
    "pollInterval": {
      "type": "duration",
      "default": "100ms",
      "group": "Processing"
    },
    "prefetch": {
      "type": "integer",
      "unit": "messages",
      "default": 20,
      "min": 0,
      "group": "Processing"
    },
    "processingTime": {
      "type": "distribution",
      "unit": "ms",
      "default": {
        "kind": "lognormal",
        "median": 50,
        "p99": 400
      },
      "group": "Processing",
      "description": "Per message"
    },
    "maxRetries": {
      "type": "integer",
      "unit": "retries",
      "default": 3,
      "min": 0,
      "group": "Reliability"
    },
    "backoff": {
      "type": "duration",
      "default": "1s",
      "group": "Reliability",
      "description": "First retry delay; doubles each attempt"
    }
  },
  "metrics": {
    "latency.p50": {
      "estimate": "processingTime.p50"
    },
    "latency.p95": {
      "estimate": "processingTime.p95"
    },
    "latency.p99": {
      "estimate": "processingTime.p99"
    },
    "throughput": {
      "unit": "msg/s",
      "rollup": "sum"
    },
    "idle": {
      "unit": "%",
      "rollup": "min"
    },
    "batchLatency": {
      "unit": "ms",
      "rollup": "max"
    },
    "retries": {
      "unit": "retries/s",
      "rollup": "sum"
    },
    "poisonMessages": {
      "unit": "messages",
      "rollup": "sum"
    }
  }
}
