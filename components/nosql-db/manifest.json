{
  "strataApi": "^1.0",
  "id": "starter.nosql-db",
  "name": "NoSQL / key-value DB",
  "version": "1.0.0",
  "category": "Data",
  "description": "A partitioned key-value or document store (DynamoDB, Cassandra, MongoDB).",
  "icon": "icon.svg",
  "extends": "base:store",
  "entry": "index.js",
  "shape": "cylinder",
  "ports": [
    {
      "name": "in",
      "direction": "in",
      "accepts": ["db-protocol", "http"],
      "exposes": ["get", "put", "delete", "query"]
    }
  ],
  "state": {
    "items": {
      "type": "map",
      "initial": {},
      "description": "By key: its value, the value before it, when each replica applied it and when a quorum had, when it was written in ms, and its size in bytes"
    },
    "windows": {
      "type": "map",
      "initial": {},
      "description": "By partition: the second its ops are counted in, and how many it has served in it"
    },
    "storage": { "type": "number", "initial": 0, "description": "Bytes stored" }
  },
  "methods": {
    "public": {
      "get": {
        "latency": 0,
        "errors": ["THROTTLED"],
        "description": "{ key } → its value, or null"
      },
      "put": {
        "latency": 0,
        "errors": ["THROTTLED"],
        "description": "{ key, value } → null"
      },
      "delete": {
        "latency": 0,
        "errors": ["THROTTLED"],
        "description": "{ key } → null"
      },
      "query": {
        "latency": 0,
        "errors": ["THROTTLED"],
        "description": "{ prefix } → the items whose keys start with it, as { key, value }"
      }
    },
    "private": {
      "route": {},
      "throttle": {},
      "replicate": {}
    }
  },
  "properties": {
    "partitions": {
      "type": "integer",
      "unit": "partitions",
      "default": 10,
      "min": 1,
      "group": "Capacity",
      "rollup": "sum"
    },
    "opsPerPartition": {
      "type": "rate",
      "default": "1000/s",
      "group": "Capacity"
    },
    "replicationFactor": {
      "type": "integer",
      "unit": "replicas",
      "default": 3,
      "min": 1,
      "group": "Durability"
    },
    "consistency": {
      "type": "enum",
      "values": ["eventual", "strong"],
      "default": "eventual",
      "group": "Durability"
    },
    "itemSize": {
      "type": "bytes",
      "default": "4KB",
      "group": "Data"
    },
    "hotKeySkew": {
      "type": "number",
      "unit": "Zipf s",
      "default": 0.8,
      "min": 0,
      "group": "Data",
      "description": "0 is uniform; above 1 a few keys take most traffic"
    },
    "itemTtl": {
      "type": "duration",
      "group": "Data",
      "description": "Leave empty to keep items forever"
    },
    "latency": {
      "type": "distribution",
      "unit": "ms",
      "default": {
        "kind": "lognormal",
        "median": 3,
        "p99": 20
      },
      "group": "Performance"
    }
  },
  "metrics": {
    "partitionOps": {
      "unit": "ops/s",
      "rollup": "max",
      "description": "Busiest partition"
    },
    "throttledOps": {
      "unit": "ops/s",
      "rollup": "sum"
    },
    "hotPartition": {
      "unit": "%",
      "rollup": "max"
    },
    "storage": {
      "unit": "bytes",
      "rollup": "sum"
    }
  }
}
