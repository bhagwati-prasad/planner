{
  "name": "strata-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Strata: design, simulate, debug, test, document and plan software architectures.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "check": "node scripts/check-boundaries.js",
    "verify": "node scripts/check-boundaries.js && node scripts/run-tests.js && node scripts/run-browser-tests.js",
    "demo": "node examples/console-demo.js",
    "typecheck": "npx -y -p typescript@5 tsc -p jsconfig.json --noEmit",
    "test:browser": "node scripts/run-browser-tests.js",
    "serve": "node packages/strata-cli/bin/strata.js serve --components starter/components --components starter/connection-types",
    "strata": "node packages/strata-cli/bin/strata.js",
    "build": "node scripts/build.js"
  },
  "bin": {
    "strata": "packages/strata-cli/bin/strata.js"
  }
}
