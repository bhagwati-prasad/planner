{
  "name": "strata-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Strata: design, simulate, debug, test, document and plan software architectures.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "check": "node tools/ci/check.js",
    "demo": "node examples/console-demo.js",
    "typecheck": "node tools/checks.js typecheck",
    "test:browser": "node scripts/run-browser-tests.js",
    "serve": "node packages/cli/bin/strata.js serve",
    "strata": "node packages/cli/bin/strata.js",
    "build": "node scripts/build.js",
    "format": "node tools/checks.js format",
    "format:check": "node tools/checks.js format:check",
    "lint": "node tools/checks.js lint"
  },
  "bin": {
    "strata": "packages/cli/bin/strata.js"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
